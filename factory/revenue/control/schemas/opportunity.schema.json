{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity observation; untrusted intake, not an execution authorization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_kind": {
      "const": "opportunity_observation"
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "github",
            "approved_marketplace",
            "customer_request"
          ]
        },
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "external_id",
        "url",
        "observed_at",
        "snapshot_sha256",
        "snapshot_ref"
      ]
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount_min_atoms": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "decimals": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            },
            {
              "type": "null"
            }
          ]
        },
        "reward_type": {
          "enum": [
            "fixed",
            "range",
            "prize_pool",
            "discretionary",
            "unknown"
          ]
        },
        "terms_evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "usd_min_microusd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "fx_evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "amount_min_atoms",
        "asset_id",
        "decimals",
        "reward_type",
        "terms_evidence_ref",
        "usd_min_microusd",
        "fx_evidence_ref"
      ]
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "japan_resident_allowed": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "ai_assistance_allowed": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "license_compatible": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "payout_route_usable": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 30,
          "uniqueItems": true
        }
      },
      "required": [
        "japan_resident_allowed",
        "ai_assistance_allowed",
        "license_compatible",
        "payout_route_usable",
        "evidence_refs"
      ]
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "UNKNOWN"
          ]
        },
        "assignee": {
          "enum": [
            "UNASSIGNED",
            "ASSIGNED_TO_KG",
            "ASSIGNED_OTHER",
            "UNKNOWN"
          ]
        },
        "claim_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "claim_state": {
          "enum": [
            "NONE",
            "APPLIED",
            "CONFIRMED",
            "DENIED",
            "NOT_REQUIRED",
            "UNKNOWN"
          ]
        },
        "competing_submission": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "assignee",
        "claim_required",
        "claim_state",
        "competing_submission",
        "deadline"
      ]
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirements_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 30,
          "uniqueItems": true
        },
        "payment_due_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "payment_terms_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "requirements_sha256",
        "acceptance_criteria",
        "payment_due_at",
        "payment_terms_ref"
      ]
    },
    "work_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 30,
          "uniqueItems": true
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 30,
          "uniqueItems": true
        },
        "expected_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 30,
          "uniqueItems": true
        },
        "excluded_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 30,
          "uniqueItems": true
        }
      },
      "required": [
        "summary",
        "languages",
        "allowed_paths",
        "expected_tests",
        "excluded_actions"
      ]
    },
    "estimates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compute_cost_upper_microusd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "other_cash_cost_upper_microusd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "human_minutes_upper": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "runner_minutes_upper": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "p_assign_permyriad": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "p_accept_given_assign_permyriad": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "p_pay_given_accept_assign_permyriad": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "probability_basis": {
          "enum": [
            "UNKNOWN",
            "HYPOTHESIS",
            "EMPIRICAL"
          ]
        },
        "calibration_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_basis_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "compute_cost_upper_microusd",
        "other_cash_cost_upper_microusd",
        "human_minutes_upper",
        "runner_minutes_upper",
        "p_assign_permyriad",
        "p_accept_given_assign_permyriad",
        "p_pay_given_accept_assign_permyriad",
        "probability_basis",
        "calibration_ref",
        "cost_basis_ref"
      ]
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30,
      "uniqueItems": true
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "is_synthetic",
    "source",
    "reward",
    "eligibility",
    "availability",
    "terms",
    "work_scope",
    "estimates",
    "risk_flags",
    "missing_evidence",
    "evidence_refs"
  ]
}
