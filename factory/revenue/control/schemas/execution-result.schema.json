{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untrusted executor report; verifier checks artifacts and tests independently",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "LOCAL_PASS",
        "LOCAL_FAIL",
        "BLOCKED",
        "TIMED_OUT"
      ]
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30,
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "log_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "status",
          "exit_code",
          "log_ref"
        ]
      }
    },
    "quality_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30,
      "uniqueItems": true
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30,
      "uniqueItems": true
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cash_cost_microusd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_status": {
          "enum": [
            "ACTUAL",
            "UPPER_BOUND",
            "ESTIMATE",
            "UNKNOWN"
          ]
        },
        "cost_evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "human_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "cash_cost_microusd",
        "cost_status",
        "cost_evidence_ref",
        "wall_seconds",
        "human_minutes"
      ]
    },
    "submission_status": {
      "const": "NOT_SUBMITTED"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "is_synthetic",
    "job_id",
    "status",
    "base_commit",
    "artifact_sha256",
    "artifact_ref",
    "changed_paths",
    "tests",
    "quality_notes",
    "unresolved",
    "usage",
    "submission_status",
    "finished_at"
  ]
}
